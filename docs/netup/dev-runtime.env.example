# Dev-only, read-only NetUP Lab runtime for compose.dev.yaml.
# Copy to ignored .dev-secrets/netup-runtime.env (0600) and fill credentials
# from the existing protected .env.netup-lab. Never commit the runtime copy.
BILLING_PROVIDER=NETUP
NETUP_PURPOSE=lab
NETUP_ALLOW_PLAINTEXT_LAB=true
NETUP_LAB_AS_OF_UTC=2026-10-10T12:00:00+00:00
NETUP_HOST=172.17.7.1
NETUP_PORT=3306
NETUP_DATABASE=UTM5
NETUP_USER=
NETUP_PASSWORD=
