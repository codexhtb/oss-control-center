{
	admin off
	auto_https off
	default_sni sd.oss-ab.net
}

# The normal OCC address. Source filtering belongs exclusively to the Proxmox
# firewall; Caddy serves the complete portal and API on TCP 443.
https://sd.oss-ab.net {
	tls /run/domain-tls/fullchain.crt /run/domain-tls/private.key

	@api path /api/v1/*
	handle @api {
		reverse_proxy api:8000 {
			header_up X-OSS-Client-IP {remote_host}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-store"
		file_server
	}

	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

# Public Telegram Mini App. No normal SPA fallback or administrative API is
# exposed on TCP 8443.
https://sd.oss-ab.net:8443 {
	tls /run/domain-tls/fullchain.crt /run/domain-tls/private.key

	handle {
		@miniapp_api path /api/v1/field-work/miniapp/*
		handle @miniapp_api {
			reverse_proxy api:8000 {
				header_up X-OSS-Client-IP {remote_host}
			}
		}
		@miniapp_page path /field-work /field-work/
		handle @miniapp_page {
			root * /srv
			rewrite * /index.html
			header Cache-Control "no-store"
			file_server
		}
		@miniapp_assets path /assets/*
		handle @miniapp_assets {
			root * /srv
			file_server
		}
		respond "Forbidden" 403
	}

	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

# Direct IP access on 8443 has the same Mini App-only boundary. The internal
# certificate is retained for operational probes, not for OCC access.
https://172.17.7.2:8443, https://178.217.74.174:8443 {
	tls /run/dev-certs/server.crt /run/dev-certs/server.key

	handle {
		@miniapp_api path /api/v1/field-work/miniapp/*
		handle @miniapp_api {
			reverse_proxy api:8000 {
				header_up X-OSS-Client-IP {remote_host}
			}
		}
		@miniapp_page path /field-work /field-work/
		handle @miniapp_page {
			root * /srv
			rewrite * /index.html
			header Cache-Control "no-store"
			file_server
		}
		@miniapp_assets path /assets/*
		handle @miniapp_assets {
			root * /srv
			file_server
		}
		respond "Forbidden" 403
	}

	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}
