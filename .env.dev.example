# Copy to .env.dev (0600) and replace both secret placeholders with random values.
APP_ENV=dev
BILLING_PROVIDER=MOCK
POSTGRES_DB=oss_control_dev
POSTGRES_USER=oss_dev
POSTGRES_PASSWORD=replace-with-random-secret
AUTH_PUBLIC_ORIGIN=https://172.17.7.2:8443
AUTH_ALLOW_HTTP_LOOPBACK=false
AUTH_HASH_KEY=replace-with-random-secret-at-least-32-bytes
READINESS_TIMEOUT_SECONDS=2
