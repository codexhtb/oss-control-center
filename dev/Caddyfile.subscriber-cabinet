{
    admin off
    auto_https off
    default_sni 172.17.7.2
}
https://172.17.7.2:9443 {
    tls /run/dev-certs/server.crt /run/dev-certs/server.key
    handle /api/v1/* {
        reverse_proxy cabinet_api:8000 {
            header_up X-OSS-Client-IP {remote_host}
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        header Cache-Control "no-store"
        file_server
    }
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
